#!/bin/sh
# Local CI gates every push (CLAUDE.md). Enable once per clone: git config core.hooksPath .githooks
# Pushes that only delete branches send nothing, and a tree that already passed `ci.sh` needs no
# second run, so a fast-forward merge of a checked branch stays quick.
passed=$(git rev-parse --git-common-dir)/ci-passed
while read -r _ local_sha _ _; do
  [ "$local_sha" = 0000000000000000000000000000000000000000 ] && continue
  grep -qx "$(git rev-parse "$local_sha^{tree}")" "$passed" 2>/dev/null || send=1
done
[ -n "$send" ] || exit 0
cd "$(git rev-parse --show-toplevel)" || exit 1
log=$(mktemp)
./ci.sh 2 >"$log" 2>&1
status=$?
grep -E 'error|warning:|FAILED|CI checks passed' "$log" | tail -40
rm -f "$log"
exit $status
